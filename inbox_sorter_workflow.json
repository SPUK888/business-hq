            "Message ID": "={{ $json.message_id }}",
            "Thread ID": "={{ $json.thread_id }}",
            "From Name": "={{ $json.from_name }}",
            "From Email": "={{ $json.from_email }}",
            "Subject": "={{ ($json.site ? '[' + $json.site + '] ' : '') + $json.subject }}",
            "Category": "={{ $json.category }}",
            "Confidence": "={{ $json.confidence }}",
            "Urgency": "={{ $json.urgency }}",
            "Needs Human": "={{ $json.needs_human }}",
            "Summary": "={{ $json.summary }}",
            "Action": "logged",
            "Reply Status": "none",
